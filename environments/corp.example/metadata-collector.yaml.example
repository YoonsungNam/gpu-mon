# Metadata Collector Helm values — production overrides template.
# Copy to environments/corp/metadata-collector.yaml (in the private repo).
# Polls S2 scheduler + VMware vCenter APIs, ingests into ClickHouse.
# Create K8s secrets for S2/vCenter credentials before enabling.

replicaCount: 1

# image.tag is injected from versions.yaml by helmfile for corp deployments.

config:
  clickhouse:
    host: clickhouse-gpu-monitoring.clickhouse.svc
    port: 9000
    database: gpu_monitoring
    username: metadata_writer
    batchSize: 500
    flushInterval: "10s"

  sources:
    # S2 batch scheduler integration
    s2:
      enabled: false               # Enable after creating S2 credentials secret
    # VMware vCenter integration
    vmware:
      enabled: false               # Enable after creating vCenter credentials secret

# Existing secret names (created separately, not by this chart)
existingSecrets:
  s2ApiToken: ""                   # K8s secret with key: token
  vcenterCredentials: ""           # K8s secret with keys: username, password

resources:
  requests:
    cpu: 100m
    memory: 128Mi
  limits:
    cpu: 500m
    memory: 256Mi
