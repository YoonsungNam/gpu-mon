# ClickHouse cluster values — production overrides template.
# Copy to environments/corp/clickhouse.yaml (in the private repo)
# and adjust sizing for your cluster.
#
# If cluster.name changes, also update clickhouse.host in defaults.yaml
# and ClickHouse endpoints in this environment's grafana.yaml and vector.yaml.

clickhouse:
  cluster:
    name: gpu-monitoring         # Must match clickhouse.host in defaults.yaml
    layout:
      shardsCount: 2             # Scale shards for write throughput
      replicasCount: 2           # Replicas for HA
  storage:
    size: 100Gi                  # Adjust based on log volume and retention
  resources:
    requests:
      cpu: "2"
      memory: 4Gi

# Schema initialization runs as an init job
schema_init:
  enabled: true
  schemas_path: /schemas
