# Grafana Helm values — production overrides template.
# Copy to environments/corp/grafana.yaml (in the private repo)
# and fill in actual hostnames and credentials.

# For production, prefer admin.existingSecret over plaintext adminPassword.
# See: https://github.com/grafana/helm-charts/tree/main/charts/grafana
adminPassword: CHANGE_ME_IN_PRODUCTION

datasources:
  datasources.yaml:
    apiVersion: 1
    datasources:
      - name: VictoriaMetrics
        type: prometheus
        url: http://vmselect-victoriametrics.monitoring.svc:8481/select/0/prometheus
        isDefault: true
        access: proxy

      - name: ClickHouse
        type: grafana-clickhouse-datasource
        url: http://clickhouse-gpu-monitoring.clickhouse.svc:8123
        jsonData:
          host: clickhouse-gpu-monitoring.clickhouse.svc
          port: 8123
          defaultDatabase: gpu_monitoring

dashboardProviders:
  dashboardproviders.yaml:
    apiVersion: 1
    providers:
      - name: gpu-mon
        orgId: 1
        folder: GPU Monitoring
        type: file
        disableDeletion: false
        options:
          path: /var/lib/grafana/dashboards/gpu-mon

# Versions pinned to match versions.yaml grafana_plugins section.
# When grafana_plugins_init: true is set in values.yaml, helmfile overrides this
# list to [] and injects an init container that loads plugins from the carrier image.
plugins:
  - grafana-clickhouse-datasource 4.14.0
  - victoriametrics-metrics-datasource 0.22.0

ingress:
  enabled: true
  hosts:
    - YOUR_GRAFANA_HOSTNAME_HERE   # e.g. grafana.monitoring.corp.internal

resources:
  requests:
    cpu: 200m
    memory: 512Mi
